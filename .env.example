# Публичная конфигурация BitVault.
# Скопируйте файл в .env.local и при необходимости переопределите значения.
# Оба значения публичные (не секреты) и попадают в клиентскую сборку.

# Базовый URL Worker API без завершающего слэша.
VITE_API_URL=https://bitvault-api.bitvault-api.workers.dev/api/v1

# Публичный Google OAuth Client ID (тот же, что GOOGLE_CLIENT_ID в Worker).
VITE_GOOGLE_CLIENT_ID=634934544232-e3fg2l93h7gmpmnvcbkngktj1a4u36pj.apps.googleusercontent.com
